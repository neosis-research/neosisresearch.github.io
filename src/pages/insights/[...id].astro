---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Arrow from '../../components/Arrow.astro';
import { publishedInsights, formatDate } from '../../lib/insights';
import { url } from '../../lib/urls';
export async function getStaticPaths() {
  return (await publishedInsights()).map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}
const { article } = Astro.props;
const { Content } = await render(article);
---

<Base title={article.data.title} description={article.data.description} article>
  <PageHero
    label={article.data.category}
    title={article.data.title}
    description={article.data.description}
  >
    <p class="note">
      <time datetime={article.data.publishedAt.toISOString()}>
        {formatDate(article.data.publishedAt)}
      </time>
      {article.data.author && ` · ${article.data.author}`}
      {article.data.updatedAt && ` · Updated ${formatDate(article.data.updatedAt)}`}
    </p>
  </PageHero>
  <div class="container">
    <article class="prose">
      <Content />
      <div class="actions">
        <a class="text-link" href={url('insights/')}>
          All Insights <Arrow />
        </a>
      </div>
    </article>
  </div>
</Base>
