---
interface Props {
  label: string;
  title: string;
  description: string;
}
const { label, title, description } = Astro.props;
---

<section class="page-hero container">
  <p class="eyebrow">
    <span class="small-dot"></span>
    {label}
  </p>
  <h1>{title}</h1>
  <div class="hero-description">
    <span class="short-rule" aria-hidden="true"></span>
    <p>{description}</p>
  </div>
  <slot />
</section>
