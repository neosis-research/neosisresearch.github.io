---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ResearchFigure from '../components/ResearchFigure.astro';
import CTA from '../components/CTA.astro';
import { url } from '../lib/urls';
import { site } from '../../site.config';
const process = [
  [
    'Define',
    'Clarify the question, the decision context, and what the research needs to make possible.',
  ],
  ['Design', 'Choose methods that fit the question, the evidence, and the real-world constraints.'],
  ['Investigate', 'Collect, structure, analyze, and model the information that matters.'],
  [
    'Interpret',
    'Examine what the findings support, where uncertainty remains, and why it matters.',
  ],
  [
    'Communicate',
    'Make the evidence useful through clear reporting, visualizations, and reproducible outputs.',
  ],
];
---

<Base title={site.tagline.replace(/\.$/, '')} description={site.description}>
  <section class="home-hero container">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="small-dot"></span>Independent inquiry. Connected expertise.
        </p>
        <h1>
          {site.tagline === 'Research for complex questions.' ? (
            <Fragment>
              Research for
              <br />
              <em>complex</em>
              <br />
              questions.
            </Fragment>
          ) : (
            site.tagline
          )}
        </h1>
        <p>
          We connect rigorous research, computational expertise, and evaluation to turn important
          questions into useful evidence.
        </p>
        <div class="actions">
          <a class="button" href={url('contact/')}>
            Discuss a Project <Arrow />
          </a>
          <a class="text-link" href={url('capabilities/')}>
            Explore Our Capabilities <Arrow />
          </a>
        </div>
      </div>
      <ResearchFigure />
    </div>
    <div class="hero-foot">
      <span>A MULTIDISCIPLINARY RESEARCH & CONSULTING FIRM</span>
      <span>Methodology before technology.</span>
      <a class="down-link" href="#our-approach">
        Explore Neosis <span aria-hidden="true">↓</span>
      </a>
    </div>
  </section>
  <section class="container section border-top" id="our-approach">
    <div class="intro-grid">
      <p class="eyebrow">01 / Our perspective</p>
      <div>
        <h2>
          The right expertise.
          <br />A more complete understanding.
        </h2>
        <p class="intro-copy">
          Complex questions rarely sit within a single discipline. Neosis Research brings together
          research design, advanced analytics, and evaluation to help organizations investigate what
          matters—and understand what comes next.
        </p>
      </div>
    </div>
  </section>
  <section class="container section-bottom" id="practices">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / Our practices</p>
        <h2>
          Two practices.
          <br />
          One commitment to rigor.
        </h2>
      </div>
      <p>
        Complementary ways of working, connected by a shared focus on sound methods and useful
        evidence.
      </p>
    </div>
    <div class="practice-grid">
      <article class="practice">
        <div class="practice-top">
          <span class="practice-number">I.</span>
          <svg class="practice-mark" viewBox="0 0 100 65" fill="none" aria-hidden="true">
            {[0, 1, 2, 3, 4, 5].map((i) => (
              <path
                d={`M2 ${12 + i * 8}C30 ${-10 + i * 12} 60 ${90 - i * 12} 98 ${12 + i * 8}`}
                stroke="currentColor"
                stroke-width=".8"
              />
            ))}
          </svg>
        </div>
        <h3>
          AI & Computational
          <br />
          Research
        </h3>
        <p>
          Specialized analytical and computational capability, brought into the context of your
          research. From statistical modeling to scientific machine learning.
        </p>
        <ul>
          <li>Advanced analytics</li>
          <li>AI & machine learning</li>
          <li>Research engineering</li>
        </ul>
        <a class="text-link" href={url('computational-research/')}>
          Explore Computational Research <Arrow />
        </a>
      </article>
      <article class="practice">
        <div class="practice-top">
          <span class="practice-number">II.</span>
          <svg class="practice-mark" viewBox="0 0 100 65" fill="none" aria-hidden="true">
            {[0, 1, 2, 3].map((i) => (
              <circle
                cx={20 + i * 20}
                cy="32"
                r={10 + i * 3}
                stroke="currentColor"
                stroke-width=".8"
              />
            ))}
            <path d="M5 32h90" stroke="currentColor" stroke-width=".8" />
          </svg>
        </div>
        <h3>
          Research, Evaluation
          <br />& Evidence
        </h3>
        <p>
          Thoughtful research design and independent evaluation to understand programs, assess
          outcomes, and inform decisions with defensible evidence.
        </p>
        <ul>
          <li>Program evaluation</li>
          <li>Mixed methods</li>
          <li>Evidence synthesis</li>
        </ul>
        <a class="text-link" href={url('research-evaluation/')}>
          Explore Research & Evaluation <Arrow />
        </a>
      </article>
    </div>
  </section>
  <section class="partnership-band section">
    <div class="container">
      <div class="partnership-layout">
        <div>
          <p class="eyebrow">03 / Sponsored research partnerships</p>
          <h2>
            Part of your team.
            <br />
            Focused on the research.
          </h2>
        </div>
        <div>
          <p class="lead">Important research is a collaborative effort.</p>
          <p>
            We can join multidisciplinary teams at the proposal stage or contribute specialized
            expertise to funded work. Define the question, the contribution, and the right way to
            collaborate.
          </p>
          <a class="text-link" href={url('sponsored-research/')}>
            Explore Research Partnerships <Arrow />
          </a>
        </div>
      </div>
      <div class="partnership-meta">
        <span>New proposals</span>
        <span>Funded research</span>
        <span>Computational collaboration</span>
        <span>Independent evaluation</span>
      </div>
    </div>
  </section>
  <section class="container section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / Connected capabilities</p>
        <h2>Depth where it matters.</h2>
      </div>
      <a class="text-link" href={url('capabilities/')}>
        View All Capabilities <Arrow />
      </a>
    </div>
    <div class="capability-summary">
      {[
        ['Research design', 'research-design'],
        ['Quantitative analysis', 'quantitative-analysis'],
        ['Computational research', 'computational-research'],
        ['Evaluation', 'evaluation'],
        ['Evidence synthesis', 'evidence'],
        ['Research data', 'research-data'],
      ].map(([label, id], i) => (
        <a href={url(`capabilities/#${id}`)}>
          <span>0{i + 1}</span>
          {label}
          <Arrow />
        </a>
      ))}
    </div>
  </section>
  <section class="container section-bottom">
    <div class="section-heading">
      <div>
        <p class="eyebrow">05 / How we work</p>
        <h2>
          The question leads.
          <br />
          The method follows.
        </h2>
      </div>
      <p>We work from the problem outward, bringing clarity to each stage of the research.</p>
    </div>
    <div class="process">
      {process.map(([title, text], i) => (
        <div>
          <span class="step">0{i + 1} /</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="tint-section section">
    <div class="container sector-layout">
      <div>
        <p class="eyebrow">06 / Across disciplines & sectors</p>
        <h2>
          Different contexts.
          <br />
          Shared curiosity.
        </h2>
        <p class="muted">
          For organizations with important questions and a need for additional research capability.
        </p>
      </div>
      <ul class="sector-list">
        {[
          'Academic Research',
          'Healthcare & Clinical Research',
          'Public Health',
          'Government',
          'Foundations & Nonprofits',
          'Life Sciences',
          'Industry R&D',
        ].map((sector) => (
          <li>{sector}</li>
        ))}
      </ul>
    </div>
  </section>
  <section class="container section insight-preview">
    <div>
      <p class="eyebrow">07 / From Neosis</p>
      <h2 style="margin-top:20px">
        Notes on
        <br />
        the work.
      </h2>
    </div>
    <div class="launch-note">
      <p class="eyebrow">Insights / Forthcoming</p>
      <h3>A space for considered perspectives.</h3>
      <p class="muted">
        Research notes on methods, evidence, evaluation, and the thoughtful application of
        computational science.
      </p>
      <a class="text-link" href={url('insights/')}>
        Explore Insights <Arrow />
      </a>
    </div>
  </section>
  <CTA />
</Base>
