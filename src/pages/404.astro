---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../lib/urls';
---

<Base
  title="Page Not Found"
  description="This page could not be found. Return to Neosis Research or explore our research capabilities."
  noindex
>
  <section class="container not-found">
    <p class="eyebrow">404 / An unexpected turn</p>
    <h1>
      Let’s find a<br />
      better starting point.
    </h1>
    <p>The page you are looking for may have moved, or the address may be incomplete.</p>
    <div class="actions">
      <a class="button" href={url()}>
        Return Home <Arrow />
      </a>
      <a class="text-link" href={url('capabilities/')}>
        Explore Our Capabilities <Arrow />
      </a>
    </div>
  </section>
</Base>
