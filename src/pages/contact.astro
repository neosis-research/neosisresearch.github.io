---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { contactEmail } from '../../site.config';
---

<Base
  title="Discuss a Project"
  description="Prepare an inquiry about computational research, program evaluation, sponsored research, or a multidisciplinary collaboration with Neosis Research."
>
  <PageHero
    label="Contact / Begin a conversation"
    title="Let’s discuss the research."
    description="An emerging question, a defined project, or a need for specialized expertise. Start with where you are."
  />
  <section class="container border-top section">
    <div class="contact-layout">
      <div class="contact-aside">
        <p class="eyebrow">A useful starting point</p>
        <h2>
          Tell us what
          <br />
          you’re exploring.
        </h2>
        <p class="muted">
          A short description of the question, the project’s stage, and the expertise you need is
          enough to begin shaping a conversation.
        </p>
        <ul>
          <li>Computational & analytical projects</li>
          <li>Research & program evaluation</li>
          <li>Sponsored research partnerships</li>
          <li>Proposals & multidisciplinary collaboration</li>
          <li>Subcontracts & defined work packages</li>
        </ul>
        <div class="contact-status">
          {contactEmail ? (
            <>
              <strong>Contact Neosis directly</strong>
              <a class="text-link" href={`mailto:${contactEmail}`}>
                {contactEmail}
                <Arrow />
              </a>
            </>
          ) : (
            <>
              <strong>Our contact channel is being established.</strong>
              <p>
                Direct email inquiries are not yet available. You can prepare and save a project
                outline here for a future conversation. Nothing is sent to Neosis.
              </p>
            </>
          )}
        </div>
      </div>
      <div>
        <form id="inquiry-form" class="inquiry-form" data-email={contactEmail || ''}>
          <h2>Prepare a project inquiry.</h2>
          <p>
            {contactEmail
              ? 'Create an email draft in your own email app. This website does not submit or store your inquiry.'
              : 'Use this worksheet to organize your thoughts. You can copy or download the outline for your own use.'}
          </p>
          <div class="field-pair">
            <div class="field">
              <label for="name">
                Your name <span>(optional)</span>
              </label>
              <input id="name" name="name" autocomplete="name" maxlength="120" />
            </div>
            <div class="field">
              <label for="organization">
                Organization <span>(optional)</span>
              </label>
              <input
                id="organization"
                name="organization"
                autocomplete="organization"
                maxlength="180"
              />
            </div>
          </div>
          <div class="field">
            <label for="topic">
              Area of interest <span>(required)</span>
            </label>
            <select id="topic" name="topic" required>
              <option value="">Select an area</option>
              <option>AI & Computational Research</option>
              <option>Research, Evaluation & Evidence</option>
              <option>Sponsored Research Partnership</option>
              <option>Multidisciplinary / Other Inquiry</option>
            </select>
          </div>
          <div class="field">
            <label for="question">
              What are you working on? <span>(required)</span>
            </label>
            <textarea
              id="question"
              name="question"
              required
              maxlength="3000"
              rows="5"
              aria-describedby="question-help"
            ></textarea>
            <small id="question-help" class="muted">
              Include the question, current stage, and the contribution you have in mind. Please
              omit confidential or sensitive information.
            </small>
          </div>
          <div class="field">
            <label for="timing">
              Timing or proposal deadline <span>(optional)</span>
            </label>
            <input id="timing" name="timing" maxlength="180" />
          </div>
          <button class="button" type="submit" id="prepare-button" disabled>
            Prepare Inquiry <Arrow />
          </button>
          <p class="form-help" id="form-explanation">
            The worksheet runs only in your browser. No information is sent or saved automatically.
          </p>
          <noscript>
            <p class="note">
              Enable JavaScript to prepare an outline, or write one in your own document using the
              prompts above.
              {contactEmail && (
                <>
                  {' '}
                  You can also <a href={`mailto:${contactEmail}`}>email Neosis directly</a>.
                </>
              )}
            </p>
          </noscript>
          <section id="inquiry-output" class="inquiry-output" hidden>
            <h3>Your inquiry outline</h3>
            <label for="prepared-text" class="eyebrow">
              Review and edit before using
            </label>
            <textarea id="prepared-text" class="prepared-text" rows="10"></textarea>
            <div class="actions">
              <button class="button button-outline" id="copy-inquiry" type="button">
                Copy Outline
              </button>
              <button class="button button-outline" id="download-inquiry" type="button">
                Download .txt
              </button>
              {contactEmail && (
                <button class="button" id="email-inquiry" type="button">
                  Open Email Draft <Arrow />
                </button>
              )}
            </div>
            <p class="status-message" role="status" id="inquiry-status" aria-live="polite"></p>
          </section>
        </form>
        <section class="privacy-note" id="privacy">
          <h2>A note on privacy.</h2>
          <p>
            This website uses no analytics or marketing trackers. The inquiry worksheet processes
            text locally in your browser; it does not transmit your entries. Downloads are saved to
            your device. If an email contact is available, opening a draft passes your text to your
            chosen email application, where you decide whether to send it.
          </p>
          <p>
            GitHub Pages hosts this site and may collect technical request information under{' '}
            <a
              class="text-link"
              href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement"
            >
              GitHub’s privacy statement
            </a>
            . Please do not include patient data, confidential research materials, or other
            sensitive information in an initial inquiry.
          </p>
        </section>
      </div>
    </div>
  </section>
</Base>
<script>
  const form = document.querySelector<HTMLFormElement>('#inquiry-form')!;
  const output = document.querySelector<HTMLElement>('#inquiry-output')!;
  const prepared = document.querySelector<HTMLTextAreaElement>('#prepared-text')!;
  const status = document.querySelector<HTMLElement>('#inquiry-status')!;
  const prepare = document.querySelector<HTMLButtonElement>('#prepare-button')!;
  prepare.disabled = false;
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const values = new FormData(form);
    const lines = [
      'Project inquiry — Neosis Research',
      '',
      ...['name', 'organization', 'topic', 'timing'].flatMap((key) => {
        const value = String(values.get(key) || '').trim();
        const labels: Record<string, string> = {
          name: 'Name',
          organization: 'Organization',
          topic: 'Area of interest',
          timing: 'Timing',
        };
        return value ? [`${labels[key]}: ${value}`] : [];
      }),
      '',
      'Research question / project context',
      String(values.get('question') || '').trim(),
    ];
    prepared.value = lines.join('\n');
    output.hidden = false;
    status.textContent = 'Outline prepared. Nothing has been sent.';
    prepared.focus();
  });
  document.querySelector('#copy-inquiry')!.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(prepared.value);
      status.textContent = 'Outline copied. Nothing has been sent.';
    } catch {
      prepared.focus();
      prepared.select();
      status.textContent =
        'Copy is unavailable in this browser. The outline is selected; use your device’s copy command.';
    }
  });
  document.querySelector('#download-inquiry')!.addEventListener('click', () => {
    const blob = new Blob([prepared.value], { type: 'text/plain;charset=utf-8' });
    const objectURL = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = objectURL;
    link.download = 'neosis-project-inquiry.txt';
    link.click();
    setTimeout(() => URL.revokeObjectURL(objectURL), 1000);
    status.textContent = 'Download prepared. Nothing has been sent.';
  });
  document.querySelector('#email-inquiry')?.addEventListener('click', () => {
    if (!form.dataset.email) return;
    location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent('Research inquiry — ' + (form.querySelector<HTMLSelectElement>('#topic')?.value || 'Neosis Research'))}&body=${encodeURIComponent(prepared.value)}`;
    status.textContent =
      'Your email app will open if one is configured. Review the draft there before sending; otherwise copy the outline and email it directly.';
  });
</script>
