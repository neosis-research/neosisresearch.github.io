---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import OpticalStudy from '../components/OpticalStudy.astro';
import CTA from '../components/CTA.astro';
import { url } from '../lib/urls';
import { site } from '../../site.config';
const process = [
  [
    'Define',
    'Start with the question. Understand the context, the decision, and what needs to be learned.',
  ],
  [
    'Design',
    'Choose the methods. Shape an approach around the evidence and the real-world constraints.',
  ],
  ['Investigate', 'Follow the evidence. Collect, structure, analyze, and test with care.'],
  ['Interpret', 'Make sense of the findings. Examine uncertainty, meaning, and what comes next.'],
  ['Communicate', 'Make the work useful. Deliver clear evidence and reproducible outputs.'],
];
---

<Base title={site.tagline.replace(/\.$/, '')} description={site.description}>
  <section class="home-hero">
    <div class="hero-atmosphere" aria-hidden="true"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow hero-badge">
          <span class="signal-dot"></span>Independent inquiry. Connected expertise.
        </p>
        <h1>
          {site.tagline === 'Complex questions. Clearer understanding.' ? (
            <Fragment>
              Complex
              <br />
              questions.
              <br />
              <span class="hero-conclusion">
                Clearer <em>understanding.</em>
              </span>
            </Fragment>
          ) : (
            site.tagline
          )}
        </h1>
        <p>
          Rigorous research. Advanced computation. Meaningful evidence. We connect disciplines to
          bring important questions into focus.
        </p>
        <div class="actions">
          <a class="button" href={url('contact/')}>
            Discuss a Project{' '}
            <span class="button-icon">
              <Arrow />
            </span>
          </a>
          <a class="text-link" href={url('capabilities/')}>
            Explore Our Capabilities <Arrow />
          </a>
        </div>
      </div>
      <OpticalStudy />
    </div>
    <div class="container hero-foot">
      <span>A MULTIDISCIPLINARY RESEARCH & CONSULTING FIRM</span>
      <a href="#practices" class="down-link">
        Discover our approach{' '}
        <span class="round-arrow" aria-hidden="true">
          ↓
        </span>
      </a>
    </div>
  </section>
  <section class="container practice-section" id="practices">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span class="section-index">01</span> Connected practices
        </p>
        <h2>
          Different disciplines.
          <br />
          <span class="subtle-text">A deeper perspective.</span>
        </h2>
      </div>
      <p>
        The right expertise changes what you can see. Our practices bring complementary ways of
        thinking to the same commitment: rigorous, useful research.
      </p>
    </div>
    <div class="practice-grid">
      <article class="practice practice-computational">
        <div class="practice-glow" aria-hidden="true"></div>
        <div class="practice-top">
          <span class="pill-label">Practice I</span>
          <span class="practice-corner" aria-hidden="true">
            01 /
          </span>
        </div>
        <div class="practice-visual" aria-hidden="true">
          <svg viewBox="0 0 440 180" fill="none">
            {Array.from({ length: 19 }, (_, i) => (
              <path
                d={`M-20 ${40 + i * 8} C100 ${-40 + i * 12} 185 ${270 - i * 11} 280 ${55 + i * 5} S410 ${-10 + i * 13} 460 ${40 + i * 8}`}
                stroke="currentColor"
                opacity={0.22 + i * 0.025}
              />
            ))}
          </svg>
        </div>
        <h3>
          AI & Computational
          <br />
          Research
        </h3>
        <p>
          Specialized analytical capability for ambitious research questions. From statistical
          modeling to scientific machine learning and reproducible software.
        </p>
        <ul>
          <li>Advanced analytics</li>
          <li>Machine learning</li>
          <li>Research engineering</li>
        </ul>
        <a class="practice-link" href={url('computational-research/')}>
          <span>Explore Computational Research</span>
          <span class="round-arrow">
            <Arrow />
          </span>
        </a>
      </article>
      <article class="practice practice-evaluation">
        <div class="practice-glow" aria-hidden="true"></div>
        <div class="practice-top">
          <span class="pill-label">Practice II</span>
          <span class="practice-corner" aria-hidden="true">
            02 /
          </span>
        </div>
        <div class="practice-visual" aria-hidden="true">
          <svg viewBox="0 0 440 180" fill="none">
            {Array.from({ length: 9 }, (_, i) => (
              <ellipse
                cx={130 + i * 22}
                cy="90"
                rx={55 + i * 2}
                ry={65 - i * 3}
                stroke="currentColor"
                opacity={0.25 + i * 0.07}
              />
            ))}
            <path d="M50 90h340" stroke="currentColor" stroke-opacity=".3" />
            <circle cx="220" cy="90" r="4" fill="currentColor" />
          </svg>
        </div>
        <h3>
          Research, Evaluation
          <br />& Evidence
        </h3>
        <p>
          Thoughtful research design and independent evaluation. Understand implementation, examine
          outcomes, and build evidence for the decisions ahead.
        </p>
        <ul>
          <li>Program evaluation</li>
          <li>Mixed methods</li>
          <li>Evidence synthesis</li>
        </ul>
        <a class="practice-link" href={url('research-evaluation/')}>
          <span>Explore Research & Evaluation</span>
          <span class="round-arrow">
            <Arrow />
          </span>
        </a>
      </article>
    </div>
  </section>
  <section class="container section" id="our-approach">
    <div class="perspective-grid">
      <div>
        <p class="eyebrow">
          <span class="section-index">02</span> Our perspective
        </p>
        <span class="oversized-asterisk" aria-hidden="true">
          ✳
        </span>
      </div>
      <div>
        <h2 class="perspective-statement">
          The question leads.
          <br />
          The method follows.
          <br />
          <em>Understanding is the aim.</em>
        </h2>
        <div class="perspective-copy">
          <p>
            Complex questions rarely fit within a single discipline. We connect research design,
            advanced analytics, and evaluation to investigate what matters.
          </p>
          <p>
            Technology is one part of that work. Judgment, context, and a clear understanding of the
            problem are just as essential.
          </p>
        </div>
        <a class="text-link" href={url('about/')}>
          The Thinking Behind Neosis <Arrow />
        </a>
      </div>
    </div>
  </section>
  <section class="partnership-section">
    <div class="container partnership-window">
      <div class="partnership-motif" aria-hidden="true">
        {Array.from({ length: 8 }, (_, i) => (
          <span style={`--i:${i}`}></span>
        ))}
      </div>
      <div class="partnership-layout">
        <div>
          <p class="eyebrow">
            <span class="signal-dot"></span> Sponsored research partnerships
          </p>
          <h2>
            Part of your team.
            <br />
            <em>Invested in the question.</em>
          </h2>
        </div>
        <div>
          <p class="lead">Important research is a collaborative effort.</p>
          <p>
            We can join multidisciplinary teams at the proposal stage or contribute specialized
            expertise to funded work. A clear role. A thoughtful contribution. A shared research
            purpose.
          </p>
          <a class="button button-glass" href={url('sponsored-research/')}>
            Explore Research Partnerships <Arrow />
          </a>
        </div>
      </div>
      <div class="partnership-meta">
        <span>New proposals</span>
        <span>Funded research</span>
        <span>Computational collaboration</span>
        <span>Independent evaluation</span>
      </div>
    </div>
  </section>
  <section class="container section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">
          <span class="section-index">03</span> The capability spectrum
        </p>
        <h2>
          Depth, where
          <br />
          <span class="subtle-text">your research needs it.</span>
        </h2>
      </div>
      <a class="text-link" href={url('capabilities/')}>
        View All Capabilities <Arrow />
      </a>
    </div>
    <div class="capability-summary">
      {[
        ['Research design', 'research-design', 'Frame the question. Shape the study.'],
        ['Quantitative analysis', 'quantitative-analysis', 'Find patterns. Examine uncertainty.'],
        ['Computational research', 'computational-research', 'Bring advanced methods to the work.'],
        ['Evaluation', 'evaluation', 'Understand implementation and impact.'],
        ['Evidence synthesis', 'evidence', 'Connect what is known to what comes next.'],
        ['Research data', 'research-data', 'Build a dependable analytical foundation.'],
      ].map(([label, id, description], i) => (
        <a href={url(`capabilities/#${id}`)}>
          <span class="capability-number">0{i + 1}</span>
          <span class="capability-name">
            {label}
            <small>{description}</small>
          </span>
          <span class="round-arrow">
            <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="method-section section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">
            <span class="section-index">04</span> How we work
          </p>
          <h2>
            A clear path through
            <br />
            <em>the complexity.</em>
          </h2>
        </div>
        <p>
          From the first conversation to the final interpretation, each stage connects back to the
          purpose of the research.
        </p>
      </div>
      <div class="process">
        {process.map(([title, text], i) => (
          <div>
            <span class="step">0{i + 1}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="container section">
    <div class="sector-layout">
      <div>
        <p class="eyebrow">
          <span class="section-index">05</span> Across sectors
        </p>
        <h2>
          Where important
          <br />
          <span class="subtle-text">questions live.</span>
        </h2>
        <p class="muted">
          For organizations with domain expertise, meaningful questions, and a need for additional
          research capability.
        </p>
      </div>
      <ul class="sector-list">
        {[
          'Academic Research',
          'Healthcare & Clinical Research',
          'Public Health',
          'Government',
          'Foundations & Nonprofits',
          'Life Sciences',
          'Industry R&D',
        ].map((sector, i) => (
          <li>
            <span class="sector-dot" aria-hidden="true"></span>
            {sector}
            <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <section class="container section-bottom">
    <div class="insight-preview">
      <div>
        <p class="eyebrow">
          <span class="section-index">06</span> Neosis perspectives
        </p>
        <h2>
          A space to
          <br />
          <em>look closer.</em>
        </h2>
      </div>
      <div class="launch-note">
        <span class="pill-label">Insights / Forthcoming</span>
        <h3>
          Considered perspectives.
          <br />
          Questions worth exploring.
        </h3>
        <p>
          Research notes on methods, evidence, evaluation, and the thoughtful application of
          computational science.
        </p>
        <a class="text-link" href={url('insights/')}>
          Explore Insights <Arrow />
        </a>
      </div>
    </div>
  </section>
  <CTA />
</Base>
