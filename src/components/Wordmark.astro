---
import { site } from '../../site.config';
import { brandMarkup } from '../lib/brand.mjs';
const maskId = `neosis-field-${crypto.randomUUID()}`;
---

<span class="brand-lockup" aria-label={site.name}>
  <svg
    class="brand-symbol"
    width="44"
    height="44"
    viewBox="0 0 100 100"
    fill="none"
    aria-hidden="true"
    set:html={brandMarkup(maskId)}
  />
  <span class="wordmark">
    <span>{site.shortName}</span>
    <span>Research</span>
  </span>
</span>
